{
  "dataset": {
    "data_dir": "data/v2/train",
    "val_data_dir": "data/v2/val",
    "batch_size": 1,
    "apply_temporal_augment": false,
    "should_apply_spec_augment": false,
    "use_gaussian_target": false,
    "gaussian_sigma": 1.0,
    "feature_source": "mert",
    "mert_features_dir": "data/mert/v2",
    "max_train_songs": 10
  },
  "model": {
    "initial_filters": 32,
    "depth": 3,
    "dilation_rates": [1, 2, 4, 8],
    "kernel_size": 3,
    "dropout_rate": 0.1,
    "input_features": 1024
  },
  "run": {
    "epoch": 40,
    "take_count": -1,
    "val_take_count": -1,
    "model_output_dir": "models_wsl/research/arch_large_10train_40ep",
    "callback_root_dir": "callbacks/research/arch_large_10train_40ep",
    "model_name": "research_arch_large_10train",
    "seed": 42,
    "confidence_threshold": 0.05,
    "tolerance_sec": 0.02,
    "min_onset_distance_ms": 50.0,
    "early_stopping_patience": 15
  }
}
