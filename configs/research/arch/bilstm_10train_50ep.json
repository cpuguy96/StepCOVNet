{
  "dataset": {
    "data_dir": "data/v2/train",
    "val_data_dir": "data/v2/val",
    "batch_size": 1,
    "apply_temporal_augment": false,
    "should_apply_spec_augment": false,
    "use_gaussian_target": true,
    "gaussian_sigma": 1.0,
    "feature_source": "mert",
    "mert_features_dir": "data/mert/v2",
    "max_train_songs": 10
  },
  "model": {
    "onset_architecture": "bilstm",
    "initial_filters": 128,
    "depth": 2,
    "dropout_rate": 0.1,
    "recurrent_units": 128,
    "input_features": 1024
  },
  "run": {
    "epoch": 50,
    "take_count": -1,
    "val_take_count": -1,
    "model_output_dir": "models_wsl/research/arch/bilstm_10train_50ep",
    "callback_root_dir": "callbacks/research/arch/bilstm_10train_50ep",
    "model_name": "arch_bilstm_10train",
    "seed": 42,
    "confidence_threshold": 0.05,
    "tolerance_sec": 0.02,
    "min_onset_distance_ms": 50.0,
    "early_stopping_patience": 15,
    "post_hoc_event_f1_export": true
  }
}
