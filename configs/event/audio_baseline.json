{
  "dataset": {
    "data_dir": "data/v2/train",
    "val_data_dir": "data/v2/val",
    "test_data_dir": "data/v2/test",
    "batch_size": 1,
    "max_audio_seconds": 300,
    "n_max_onsets": 2048,
    "max_steps_per_chart": 2048,
    "target_sample_rate": 44100,
    "truncate_long_audio": true,
    "apply_audio_augment": false
  },
  "model": {
    "frontend": "conv1d",
    "encoder": {
      "initial_filters": 16,
      "depth": 2,
      "dilation_rates": [1, 2, 4, 8],
      "kernel_size": 3,
      "dropout_rate": 0.0
    },
    "num_queries": 2048,
    "embed_dim": 256,
    "decoder_layers": 2
  },
  "run": {
    "epochs": 20,
    "tolerance_sec": 0.02,
    "confidence_threshold": 0.5,
    "min_onset_distance_ms": 50,
    "lambda_cls": 1.0,
    "lambda_time": 5.0,
    "model_output_dir": "",
    "callback_root_dir": "",
    "seed": 42
  }
}
