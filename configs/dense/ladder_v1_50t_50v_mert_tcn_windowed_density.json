    "seed": 42,
    "show_model_summary": true,
    "fit_verbose": 1,
    "early_stopping_patience": 50,
    "post_hoc_event_f1_export": true,
    "tolerance_sec": 0.02,
    "min_onset_distance_ms": 50.0,
    "confidence_threshold": 0.05
