{
  "dataset": {
    "data_dir": "",
    "val_data_dir": "",
    "training_index_path": "data/final_data/training_index_ladder_v1_50t_50v.json",
    "data_root": "data/final_data",
    "batch_size": 32,
    "apply_temporal_augment": false,
    "should_apply_spec_augment": false,
    "use_gaussian_target": true,
