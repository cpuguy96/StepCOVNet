{
  "dataset": {
    "overfit_audio_path": "data/v2/test/tide.ogg",
    "overfit_chart_path": "data/v2/test/tide.txt",
    "mert_features_dir": "data/v2/test",
    "max_audio_seconds": 300,
    "max_steps_per_chart": 2048
  },
  "model": {
    "patch_frames": 8,
    "d_model": 256,
    "n_enc_layers": 4,
    "n_dec_layers": 4,
    "token_scheme": "delta_bucketed",
    "alignment": "pointer_residual",
    "max_decode_steps": 2048,
    "dropout_rate": 0.0
  },
  "run": {
    "overfit_one_song": true,
    "lambda_time": 1.0,
    "lambda_time_ramp_epochs": 0,
    "lambda_residual": 10.0,
    "token_class_weight": "none",
    "eos_token_weight_scale": 1.0,
    "scheduled_sampling_max_p": 0.0,
    "ar_decode_val_every_n_epochs": 0,
    "use_soft_pointer_time": false,
    "init_model_path": "models_wsl/ar/perfect_overfit/run2/ar_onset_model.keras",
    "learning_rate": 0.00005,
    "length_normalize_ce": true,
    "tolerance_sec": 0.02,
    "epochs": 200,
    "checkpoint_metric": "val_overfit_gate",
    "perfect_overfit_early_stop": false,
    "model_output_dir": "models_wsl/ar/perfect_overfit/run3",
    "callback_root_dir": "callbacks/ar/perfect_overfit/run3"
  }
}
