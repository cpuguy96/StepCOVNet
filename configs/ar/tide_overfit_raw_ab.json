{
  "dataset": {
    "overfit_audio_path": "data/v2/test/tide.ogg",
    "overfit_chart_path": "data/v2/test/tide.txt",
    "mert_features_dir": "data/v2/test",
    "normalize_mert_features": false,
    "max_audio_seconds": 300,
    "max_steps_per_chart": 2048
  },
  "model": {
    "patch_frames": 8,
    "d_model": 384,
    "n_enc_layers": 4,
    "n_dec_layers": 4,
    "token_scheme": "delta_bucketed",
    "alignment": "pointer_residual",
    "max_decode_steps": 2048,
    "dropout_rate": 0.0
  },
  "run": {
    "overfit_one_song": true,
    "lambda_time": 1.0,
    "lambda_time_ramp_epochs": 0,
    "lambda_residual": 30.0,
    "lambda_incremental_consistency": 0.0,
    "incremental_consistency_max_steps": 0,
    "token_class_weight": "none",
    "eos_token_weight_scale": 0.2,
    "scheduled_sampling_max_p": 0.0,
    "use_soft_pointer_time": false,
    "learning_rate": 0.0001,
    "length_normalize_ce": true,
    "tolerance_sec": 0.02,
    "epochs": 400,
    "checkpoint_metric": "val_overfit_gate",
    "perfect_overfit_early_stop": true,
    "perfect_overfit_min_score": 0.9999,
    "perfect_overfit_patience": 3,
    "model_output_dir": "models_wsl/ar/tide_overfit_raw_ab",
    "callback_root_dir": "callbacks/ar/tide_overfit_raw_ab"
  }
}
