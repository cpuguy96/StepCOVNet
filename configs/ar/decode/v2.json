{
  "dataset": {
    "overfit_audio_path": "data/v2/test/tide.ogg",
    "overfit_chart_path": "data/v2/test/tide.txt",
    "mert_features_dir": "data/v2/test",
    "max_audio_seconds": 300,
    "max_steps_per_chart": 2048
  },
  "model": {
    "patch_frames": 8,
    "d_model": 256,
    "n_enc_layers": 4,
    "n_dec_layers": 4,
    "token_scheme": "delta_bucketed",
    "alignment": "pointer_residual",
    "max_decode_steps": 2048,
    "dropout_rate": 0.0
  },
  "run": {
    "overfit_one_song": true,
    "lambda_time": 1.0,
    "lambda_time_ramp_epochs": 100,
    "lambda_residual": 5.0,
    "token_class_weight": "inverse_freq",
    "eos_token_weight_scale": 0.2,
    "ar_decode_val_every_n_epochs": 0,
    "use_soft_pointer_time": false,
    "scheduled_sampling_max_p": 1.0,
    "scheduled_sampling_warmup_epochs": 15,
    "scheduled_sampling_ramp_epochs": 100,
    "init_model_path": "models_wsl/ar/gate_tide_overfit/ar_onset_model.keras",
    "learning_rate": 0.001,
    "length_normalize_ce": true,
    "tolerance_sec": 0.02,
    "epochs": 150,
    "checkpoint_metric": "val_event_onset_f1",
    "model_output_dir": "models_wsl/ar/gate_ar_decode/v2",
    "callback_root_dir": "callbacks/ar/gate_ar_decode/v2"
  }
}
