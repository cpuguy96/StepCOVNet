{
  "dataset": {
    "overfit_audio_path": "data/v2/test/tide.ogg",
    "overfit_chart_path": "data/v2/test/tide.txt",
    "mert_features_dir": "data/v2/test",
    "max_audio_seconds": 300,
    "max_steps_per_chart": 2048
  },
  "model": {
    "patch_frames": 8,
    "d_model": 384,
    "n_enc_layers": 4,
    "n_dec_layers": 4,
    "token_scheme": "delta_bucketed",
    "alignment": "gap_residual",
    "keep_absolute_pointer_head": false,
    "patch_delta_max_dense": 256,
    "patch_n_log_buckets": 16,
    "max_decode_steps": 2048,
    "dropout_rate": 0.0,
    "monotonic_pointer": true,
    "pointer_qk_layernorm": true
  },
  "run": {
    "overfit_one_song": true,
    "lambda_time": 1.0,
    "lambda_time_ramp_epochs": 0,
    "lambda_residual": 30.0,
    "lambda_incremental_consistency": 0.0,
    "incremental_consistency_max_steps": 0,
    "token_class_weight": "none",
    "eos_token_weight_scale": 0.2,
    "scheduled_sampling_max_p": 0.0,
    "use_soft_pointer_time": false,
    "pointer_local_ce_radius": 0,
    "pointer_soft_distance_alpha": 0.0,
    "gap_loss_weight": 1.0,
    "pointer_loss_weight": 0.0,
    "learning_rate": 0.0001,
    "length_normalize_ce": true,
    "tolerance_sec": 0.02,
    "epochs": 400,
    "checkpoint_metric": "val_overfit_gate",
    "perfect_overfit_early_stop": false,
    "model_output_dir": "models_wsl/ar/tide_gap_residual",
    "callback_root_dir": "callbacks/ar/tide_gap_residual",
    "run_label": "tide_gap_residual"
  }
}
