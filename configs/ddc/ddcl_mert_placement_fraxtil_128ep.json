{
  "dataset": {
    "training_index_path": "data/literature_fraxtil_orig/training_index_standard.json",
    "batch_size": 8,
    "memlen": 15,
    "max_train_songs": -1,
    "max_val_songs": -1,
    "cache_features": true,
    "audio_feature_type": "mert",
    "n_frames_per_beat": 16
  },
  "model": {
    "lstm_units": 200,
    "dropout_rate": 0.2,
    "dense_sizes": [512, 256],
    "mert_proj_dim": 128,
    "mert_conv_filters": 64
  },
  "run": {
    "epoch": 128,
    "steps_per_epoch": 200,
    "validation_steps": 20,
    "learning_rate": 0.0001,
    "clipnorm": 1.0,
    "seed": 42,
    "eval_slot_f1_every": 16,
    "model_output_dir": "models_wsl/ddc/ddcl_mert_placement_fraxtil_128ep",
    "callback_root_dir": "callbacks/ddc/ddcl_placement",
    "model_name": "ddcl_mert_placement_fraxtil_128ep",
    "resume": false
  }
}
