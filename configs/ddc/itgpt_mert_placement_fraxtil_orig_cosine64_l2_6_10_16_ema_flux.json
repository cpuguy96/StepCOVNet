{
  "dataset": {
    "training_index_path": "data/literature_fraxtil_orig/training_index_standard.json",
    "batch_size": 1,
    "max_train_songs": -1,
    "max_val_songs": -1,
    "cache_features": true,
    "max_beats": 2000,
    "audio_feature_type": "mert",
    "n_frames_per_beat": 24,
    "mert_cache_suffix": ".mert_l2_6_10_16.npy",
    "mert_spectral_flux": true
  },
  "model": {
    "d_model": 256,
    "n_heads": 8,
    "n_enc_layers": 8,
    "cnn_hidden": 32,
    "dropout_rate": 0.1
  },
  "run": {
    "epoch": 64,
    "steps_per_epoch": 200,
    "validation_steps": 20,
    "learning_rate": 0.0001,
    "min_learning_rate": 1e-06,
    "lr_schedule": "cosine",
    "warmup_epochs": 4,
    "weight_decay": 0.01,
    "clipnorm": 1.0,
    "use_ema": true,
    "ema_momentum": 0.995,
    "seed": 42,
    "mixed_precision": true,
    "jit_compile": false,
    "eval_slot_f1_every": 8,
    "model_output_dir": "models_wsl/ddc/itgpt_mert_placement_fraxtil_orig_cosine64_l2_6_10_16_ema_flux",
    "callback_root_dir": "callbacks/ddc/itgpt_placement",
    "model_name": "itgpt_mert_placement_fraxtil_orig_cosine64_l2_6_10_16_ema_flux",
    "resume": false
  }
}
