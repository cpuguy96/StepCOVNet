{
  "dataset": {
    "training_index_path": "data/literature_fraxtil_orig/training_index_standard.json",
    "batch_size": 8,
    "memlen": 15,
    "max_train_songs": -1,
    "max_val_songs": -1,
    "cache_features": true
  },
  "model": {
    "lstm_units": 200,
    "dropout_rate": 0.2,
    "dense_sizes": [512, 256]
  },
  "run": {
    "epoch": 8,
    "steps_per_epoch": 100,
    "validation_steps": 20,
    "learning_rate": 0.0001,
    "clipnorm": 1.0,
    "seed": 42,
    "model_output_dir": "models_wsl/ddc/ddcl_placement_fraxtil",
    "callback_root_dir": "callbacks/ddc/ddcl_placement",
    "model_name": "ddcl_placement_fraxtil"
  }
}
